    "test": "cross-env NODE_OPTIONS=--max-old-space-size=4096 react-scripts test",
    "test:ci": "cross-env NODE_OPTIONS=--max-old-space-size=4096 react-scripts test --watchAll=false --ci",
    "postbuild": "node ./src/generate-sitemap.mjs",
    "eject": "react-scripts eject",
    "publish": "npm publish --tag \"${npm_package_config_productFlavour:-latest}\" --access restricted",
    "deploy": "./deploy.sh"
  },
